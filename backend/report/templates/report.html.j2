<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Flawnetic Audit Report — {{ project_name }}</title>
  <style>
    @page {
      size: A4;
      margin: 20mm 15mm 20mm 15mm;
      @bottom-center {
        content: "Generated by Flawnetic — Automated QA Platform";
        font-family: 'Inter', sans-serif;
        font-size: 8pt;
        color: #64748b;
      }
    }
    
    body {
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: #1e293b;
      background-color: #ffffff;
      margin: 0;
      padding: 0;
      line-height: 1.5;
      font-size: 10pt;
    }

    .cover-page {
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      page-break-after: always;
      break-after: page;
      padding-top: 40px;
    }

    .header-logo {
      font-size: 24pt;
      font-weight: 800;
      color: #4f46e5;
      margin-bottom: 8px;
    }

    .header-tagline {
      font-size: 11pt;
      color: #64748b;
      margin-bottom: 40px;
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 12px;
    }

    .report-title {
      font-size: 20pt;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 24px;
    }

    .meta-box {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 30px;
    }

    .meta-row {
      display: flex;
      margin-bottom: 10px;
    }

    .meta-row:last-child {
      margin-bottom: 0;
    }

    .meta-label {
      width: 140px;
      font-weight: 600;
      color: #475569;
    }

    .meta-value {
      font-weight: 500;
      color: #0f172a;
    }

    /* Summary Table */
    .summary-title {
      font-size: 14pt;
      font-weight: 700;
      margin-bottom: 12px;
      color: #0f172a;
    }

    .summary-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 40px;
    }

    .summary-table th, .summary-table td {
      border: 1px solid #cbd5e1;
      padding: 10px 14px;
      text-align: left;
    }

    .summary-table th {
      background-color: #f1f5f9;
      font-weight: 600;
      color: #334155;
    }

    /* Severity Pills */
    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 8pt;
      font-weight: 700;
      text-transform: uppercase;
      color: #ffffff;
    }

    .badge-critical { background-color: #ef4444; }
    .badge-high     { background-color: #f97316; }
    .badge-medium   { background-color: #eab308; color: #0f172a; }
    .badge-low      { background-color: #3b82f6; }

    .badge-module {
      background-color: #64748b;
      color: #ffffff;
    }

    /* Finding Details Card */
    .finding-card {
      page-break-after: always;
      break-after: page;
      padding-top: 10px;
    }

    .finding-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 10px;
    }

    .finding-id {
      font-weight: 800;
      font-size: 12pt;
      color: #475569;
    }

    .finding-title {
      font-size: 13pt;
      font-weight: 700;
      color: #0f172a;
      flex-grow: 1;
    }

    .detail-section {
      margin-bottom: 16px;
    }

    .detail-label {
      font-weight: 700;
      font-size: 9pt;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
    }

    .detail-content {
      font-size: 10pt;
      color: #334155;
    }

    .steps-list {
      margin: 4px 0 0 18px;
      padding: 0;
    }

    .steps-list li {
      margin-bottom: 4px;
    }

    .screenshot-box {
      margin-top: 16px;
      text-align: center;
    }

    .screenshot-img {
      max-width: 100%;
      max-height: 380px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    }

    .remediation-box {
      background-color: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 6px;
      padding: 12px;
      margin-top: 14px;
      font-size: 9.5pt;
    }

    .remediation-title {
      font-weight: 700;
      color: #166534;
      margin-bottom: 4px;
    }

    .footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      text-align: center;
      font-size: 8pt;
      color: #94a3b8;
      border-top: 1px solid #e2e8f0;
      padding-top: 8px;
    }
  </style>
</head>
<body>

  <!-- COVER PAGE -->
  <div class="cover-page">
    <div class="header-logo">Flawnetic AI</div>
    <div class="header-tagline">Autonomous E2E QA Testing & Enterprise Bug Reporting Platform</div>

    <div class="report-title">Executive QA & Vulnerability Audit Report</div>

    <div class="meta-box">
      <div class="meta-row">
        <div class="meta-label">Project Name:</div>
        <div class="meta-value">{{ project_name }}</div>
      </div>
      <div class="meta-row">
        <div class="meta-label">Target URL:</div>
        <div class="meta-value">{{ base_url }}</div>
      </div>
      <div class="meta-row">
        <div class="meta-label">Scan Date:</div>
        <div class="meta-value">{{ scan_date }}</div>
      </div>
      <div class="meta-row">
        <div class="meta-label">Pages Crawled:</div>
        <div class="meta-value">{{ total_pages }}</div>
      </div>
      <div class="meta-row">
        <div class="meta-label">Total Findings:</div>
        <div class="meta-value">{{ total_findings }}</div>
      </div>
    </div>

    <div class="summary-title">Severity Breakdown</div>
    <table class="summary-table">
      <thead>
        <tr>
          <th>Severity</th>
          <th>Finding Count</th>
          <th>Percentage</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><span class="badge badge-critical">Critical</span></td>
          <td>{{ critical_count }}</td>
          <td>{{ "%.1f"|format((critical_count / total_findings * 100) if total_findings > 0 else 0) }}%</td>
        </tr>
        <tr>
          <td><span class="badge badge-high">High</span></td>
          <td>{{ high_count }}</td>
          <td>{{ "%.1f"|format((high_count / total_findings * 100) if total_findings > 0 else 0) }}%</td>
        </tr>
        <tr>
          <td><span class="badge badge-medium">Medium</span></td>
          <td>{{ medium_count }}</td>
          <td>{{ "%.1f"|format((medium_count / total_findings * 100) if total_findings > 0 else 0) }}%</td>
        </tr>
        <tr>
          <td><span class="badge badge-low">Low</span></td>
          <td>{{ low_count }}</td>
          <td>{{ "%.1f"|format((low_count / total_findings * 100) if total_findings > 0 else 0) }}%</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- FINDINGS DETAIL LIST -->
  {% for finding in findings %}
  <div class="finding-card">
    <div class="finding-header">
      <span class="finding-id">{{ finding.bug_id or ("FL-" ~ "%03d"|format(loop.index)) }}</span>
      <span class="badge badge-{{ finding.severity|lower }}">{{ finding.severity }}</span>
      <span class="badge badge-module">{{ finding.module }}</span>
      <div class="finding-title">{{ finding.title }}</div>
    </div>

    <div class="detail-section">
      <div class="detail-label">Page URL</div>
      <div class="detail-content"><code>{{ finding.page_url or base_url }}</code></div>
    </div>

    <div class="detail-section">
      <div class="detail-label">Description</div>
      <div class="detail-content">{{ finding.description }}</div>
    </div>

    {% if finding.steps_list %}
    <div class="detail-section">
      <div class="detail-label">Steps to Reproduce</div>
      <ol class="steps-list">
        {% for step in finding.steps_list %}
        <li>{{ step }}</li>
        {% endfor %}
      </ol>
    </div>
    {% endif %}

    {% if finding.expected_result or finding.actual_result %}
    <div class="detail-section">
      <div class="detail-label">Expected Result</div>
      <div class="detail-content">{{ finding.expected_result or "Application should function cleanly without errors or security gaps." }}</div>
      <div class="detail-label" style="margin-top: 8px;">Actual Result</div>
      <div class="detail-content" style="color: #b91c1c;">{{ finding.actual_result or finding.description }}</div>
    </div>
    {% endif %}

    {% if finding.root_cause_hint %}
    <div class="remediation-box">
      <div class="remediation-title">AI Remediation & Root Cause Hint</div>
      <div>{{ finding.root_cause_hint }}</div>
    </div>
    {% endif %}

    {% if finding.screenshot_base64 %}
    <div class="screenshot-box">
      <div class="detail-label" style="text-align: left; margin-bottom: 6px;">Visual Evidence Screenshot</div>
      <img src="data:image/png;base64,{{ finding.screenshot_base64 }}" class="screenshot-img" alt="Evidence Screenshot" />
    </div>
    {% endif %}
  </div>
  {% endfor %}

  <div class="footer">Generated by Flawnetic — Automated QA Platform</div>
</body>
</html>
